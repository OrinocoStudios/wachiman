# Wachiman settings. Copy to $WACHIMAN_HOME/config.env (default ~/.wachiman/config.env).
# Plain KEY=VALUE lines; nothing here is executed. Environment variables with the
# same name win over this file.

# Seconds between two radar samples.
WACHIMAN_RADAR_INTERVAL=30

# Telegram alerts (optional). Create a bot with @BotFather and get your chat id
# from @userinfobot. Keep this file private: chmod 600.
WACHIMAN_TELEGRAM_BOT_TOKEN=
WACHIMAN_TELEGRAM_CHAT_ID=

# Where files live. Defaults shown; uncomment to move them.
# WACHIMAN_HOME=~/.wachiman
# WACHIMAN_DB=~/.wachiman/radar.db
# WACHIMAN_GEO_DB=~/.wachiman/geo.db

# WACHIMAN_LANG=en
# Alert when one app uploads more than this many MB within one hour (0 = off).
# WACHIMAN_UPLOAD_ALERT_MB=100

# --- Guard (screen-lock watcher: alert + webcam photos) -------------------------
# WACHIMAN_GUARD_POLL=3
# WACHIMAN_GUARD_IDLE_ACTIVE=10
# WACHIMAN_GUARD_IDLE_QUIET=60
# WACHIMAN_GUARD_BURST_COOLDOWN=60
# WACHIMAN_GUARD_GRACE=30
# 1 = never delete photos. Set 0 only after confirming by hand that your Mac asks
# for a password when waking up; then a quick unlock deletes the photos as a false alarm.
# WACHIMAN_GUARD_PARANOID=1
# WACHIMAN_GUARD_DEBUG=0
# WACHIMAN_GUARD_SKIP_FRAMES=12
# WACHIMAN_GUARD_PHOTO_GAP=1
# Camera by name (looked up on every start); WACHIMAN_CAM is the fallback index.
# WACHIMAN_CAM_NAME=
# WACHIMAN_CAM=0
# Default: ffmpeg found on PATH.
# WACHIMAN_FFMPEG=

# --- Memory watch ----------------------------------------------------------------
# WACHIMAN_MEM_POLL=20
# WACHIMAN_MEM_PRESSURE_WARN=20
# WACHIMAN_MEM_PRESSURE_CRIT=10
# WACHIMAN_MEM_SWAPOUT_WARN_MBS=25
# WACHIMAN_MEM_SWAPOUT_GATE_PRESS=35
# WACHIMAN_MEM_RECOVER_MARGIN=5
# WACHIMAN_MEM_COOLDOWN=900

# --- Stealer watch ---------------------------------------------------------------
# WACHIMAN_STEALER_POLL=300
# WACHIMAN_STEALER_COOLDOWN=3600
# Space-separated list; replaces the built-in one.
# WACHIMAN_STEALER_C2_DOMAINS=glowmedaesthetics.com
